{
  "swagger": "2.0",
  "info": {
    "title": "Movie Database API",
    "description": "RESTful API for managing movies and directors with full CRUD, validation, and error handling.",
    "version": "1.0.0"
  },
  "host": "cse341-project-827z.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "paths": {
    "/topmovies": {
      "get": {
        "description": "Retrieves all movies.",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/topmovies/{id}": {
      "get": {
        "description": "Get a single movie by ID.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/directors": {
      "post": {
        "description": "Create a new director record.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "firstName": { "type": "string", "example": "Speedy" },
                "lastName": { "type": "string", "example": "Fox" },
                "nationality": { "type": "string", "example": "Uganda" },
                "birthYear": { "type": "string", "example": "2006" },
                "knownFor": { "type": "string", "example": "Movies" }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Bad Request" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/directors/{id}": {
      "get": {
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      },
      "put": {
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      },
      "delete": {
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      }
    }
  }
}